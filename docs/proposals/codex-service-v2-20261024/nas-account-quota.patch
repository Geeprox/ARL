 from contract import APPS,MODEL,PREFIX,encode
 from local_api import atomic,read_json
 
+def archive_terminal(queue):
+    for app in APPS:
+        directory=queue/app;archive=directory/'archive'
+        try:
+            if archive.is_symlink():continue
+            archive.mkdir(mode=0o700,exist_ok=True)
+            for request_path in (directory/'requests').glob('*.json'):
+                response=directory/'responses'/request_path.name
+                if not response.exists():continue
+                answer=read_json(response,131072);request=read_json(request_path,16384)
+                if answer.get('state')!='succeeded' or answer.get('app')!=app or answer.get('id')!=request_path.stem:continue
+                if time.time()-answer.get('at',time.time())<600 or time.time()-response.stat().st_mtime<600 or request.get('expires_at',time.time())>time.time():continue
+                archived=archive/request_path.name
+                if not archived.exists():atomic(archived,answer)
+                if read_json(archived,131072)!=answer:continue
+                # Archive verified terminal receipts; preserve uncertain and active work.
+                response.unlink();request_path.unlink()
+        except (OSError,ValueError,KeyError,TypeError):pass
+
