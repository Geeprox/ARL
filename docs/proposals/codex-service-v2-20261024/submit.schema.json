{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arl:codex:submit:v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "arl/1"
    },
    "app": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,149}$"
    },
    "method": {
      "const": "submit"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "codex.text.generate.v2"
        },
        "key": {
          "type": "string",
          "format": "uuid"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 2
            },
            "resolution_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "messages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "enum": [
                      "system",
                      "developer",
                      "user",
                      "assistant"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 1048576
                  }
                },
                "required": [
                  "role",
                  "content"
                ]
              }
            }
          },
          "required": [
            "schema_version",
            "resolution_id",
            "messages"
          ]
        }
      },
      "required": [
        "tool",
        "key",
        "args"
      ]
    }
  },
  "required": [
    "protocol",
    "app",
    "method",
    "params"
  ]
}
